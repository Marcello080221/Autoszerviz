@page
@model Autoszerviz.Pages.Javitasok.IndexModel
@{
    ViewData["Title"] = "Javítások";
}
@if (TempData["Hiba"] is string hiba)
{
    <div class="alert alert-danger">@hiba</div>
}

<h1>Javítások</h1>

<p><a asp-page="Create" class="btn btn-primary">Új javítás</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Ügyfél</th>
            <th>Rendszám</th>
            <th>Leírás</th>
            <th>Költség</th>
            <th>Állapot</th>
            <th>Felvétel</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var j in Model.Javitasok)
        {
            <tr>
                <td>@j.Ugyfel.Nev</td>
                <td>@j.Rendszam</td>
                <td>@j.Leiras</td>
                <td>@(j.Koltseg?.ToString("C0") ?? "-")</td>
                <td>@j.Allapot</td>
                <td>@j.FelvetelDatuma.ToString("yyyy.MM.dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>